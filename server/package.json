{
  "name": "quest-dating-server",
  "version": "2.0.0",
  "description": "Quest Dating — персональные романтические квесты. Backend API.",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "vitest run --config vitest.config.js",
    "db:seed": "node scripts/seed-database.js",
    "db:migrate": "node scripts/run-migrations.js",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest run --config vitest.config.js",
    "test:integration": "vitest run --config vitest.integration.config.js",
    "test:integration:watch": "vitest --config vitest.integration.config.js"
  },
  "keywords": [
    "quest",
    "marketplace",
    "dating",
    "express",
    "postgresql"
  ],
  "author": "Vlad Petrov",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.1",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "nanoid": "^5.1.16",
    "pg": "^8.11.3",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.2.1",
    "@vitest/coverage-v8": "^4.1.11",
    "nodemon": "^3.1.0",
    "supertest": "^7.0.0",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=9.0.0"
  }
}
