{
  "name": "quest-dating-server",
  "version": "2.0.0",
  "description": "Quest Dating — персональные романтические квесты. Backend API.",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "vitest run",
    "db:seed": "node scripts/seed-database.js",
    "db:migrate": "node scripts/run-migrations.js",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration"
  },
  "keywords": [
    "quest",
    "marketplace",
    "dating",
    "express",
    "postgresql"
  ],
  "author": "Vlad Petrov",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "express-rate-limit": "^8.2.1",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^1.4.5-lts.1",
    "nanoid": "^5.0.5",
    "nodemailer": "^6.9.14",
    "pg": "^8.11.3",
    "sharp": "^0.33.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.0.18",
    "nodemon": "^3.1.0",
    "supertest": "^7.0.0",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}