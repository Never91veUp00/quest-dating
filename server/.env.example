# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=quest_dating
DB_USER=quest_user
DB_PASSWORD=your_password_here

# JWT Secret (для авторизации)
# Сгенерируйте криптографически стойкий ключ:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_random_32_char_secret_here
JWT_EXPIRES_IN=7d

# Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
# Секрет для верификации webhook-запросов от Telegram (setWebhook secret_token)
# Сгенерируйте: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TELEGRAM_WEBHOOK_SECRET=your_webhook_secret_here

# Admin
ADMIN_USERNAME=your_admin_username
ADMIN_PASSWORD_HASH=your_bcrypt_hash_here

# CORS Settings
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Email (Resend) — обязательно для admin-уведомлений
RESEND_API_KEY=re_your_resend_api_key_here
NOTIFY_EMAIL=your_admin_email@example.com

# Email Configuration (опционально, legacy SMTP)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASSWORD=your_app_password
# SMTP_FROM=noreply@questdating.com

# File Upload
MAX_FILE_SIZE=5242880
UPLOAD_DIR=./uploads

# Session (для будущего)
# SESSION_SECRET=your_session_secret_here
# SESSION_MAX_AGE=86400000

# Payment (для будущего)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLIC_KEY=pk_test_...

# Frontend URL (для CORS и email links)
FRONTEND_URL=http://localhost:3000

# API Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100